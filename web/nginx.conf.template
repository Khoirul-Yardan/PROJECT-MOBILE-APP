server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The Flutter WebView is a different origin than this container, and
    # the JS bridge only trusts messages it receives directly inside the
    # WebView (not cross-origin postMessage) — CORS here just lets the page
    # be fetched/previewed from a plain browser too during development.
    add_header Access-Control-Allow-Origin "*" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin relay for self-hosted agent calls — see relay/server.js.
    # Proxied under this container's own origin so the browser's fetch()
    # never crosses origins (and so never triggers a CORS preflight) even
    # though the relay itself is a separate container.
    location /relay/ {
        # Resolved per-request (variable + resolver) instead of at startup,
        # so nginx still boots if the relay isn't up yet — needed on
        # Railway, where the two services start independently and the
        # private hostname (RELAY_URL) only resolves once relay is running.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $relay_upstream "${RELAY_URL}";
        rewrite ^/relay/(.*)$ /$1 break;
        proxy_pass $relay_upstream;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        # nginx's default is 1MB — fine for the small JSON-RPC/agent-chat
        # bodies this route originally carried, but /relay/assemblyai/upload
        # (see ASSEMBLYAI-DIARIZATION.md) now sends whole recorded sessions
        # as raw audio through here too. Confirmed live on a real device: a
        # ~70s AAC recording is already ~1.6MB and got rejected with a 413
        # before this was added. 50m comfortably covers a long BPJS session.
        client_max_body_size 50m;
        # Relay allows AI replies up to 100s upstream; nginx's 60s default
        # would cut them off first.
        proxy_read_timeout 120s;
    }

    # The whole point of this container is "rebuild it, everyone gets the
    # update immediately" — a browser (or the app's WebView) aggressively
    # caching .js/.html defeats that and causes exactly the kind of stale
    # "module doesn't export X" error a plain rebuild should have fixed.
    # no-cache forces revalidation on every load instead of no-store's full
    # re-download, so updates are still instant without wasting bandwidth.
    location ~* \.(?:js|mjs|html|css|svg)$ {
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        try_files $uri =404;
    }
}
