# Salin ke web/.env (sudah di-gitignore) lalu isi. docker compose membacanya otomatis.
# JANGAN commit file .env yang berisi nilai asli.

# Login panel admin (http://localhost:8095). Wajib diisi; password minimal 12 karakter.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Acak panjang; ganti untuk memaksa semua admin login ulang. (Kosong = acak tiap restart.)
SESSION_SECRET=

# Supabase -> Project Settings -> API Keys -> "secret" (sb_secret_...) atau service_role.
# Melewati RLS: hanya server admin yang boleh memegangnya, tidak pernah ke browser/APK.
SUPABASE_SERVICE_KEY=
# Opsional; default ke proyek di web/public/supabase-config.js
# SUPABASE_URL=https://xxxx.supabase.co
